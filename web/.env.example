# web/.env.example — copy to web/.env.local and set for your environment.
#
# Base URL of the LifeOS backend API the frontend calls.
# Local dev (default if unset): http://127.0.0.1:8000
# Production: your deployed API origin over HTTPS, e.g. https://api.example.com
# Must be reachable from the browser and (for prod) HTTPS to avoid mixed-content.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
