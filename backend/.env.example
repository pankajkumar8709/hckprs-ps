# backend/.env.example — Section 0.5 template. Copy to backend/.env and fill in.
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" for dev.
DATABASE_URL=
JWT_SECRET=
JWT_ACCESS_EXPIRE_MIN=15
JWT_REFRESH_EXPIRE_DAYS=7
LLM_API_KEY=
STORAGE_BACKEND=local
S3_BUCKET=
REDIS_URL=
RATE_LIMIT_PER_MIN=60
# --- Production hardening (F3.12) ---
# Allowed CORS origins (comma-separated). For local dev leave as-is; in prod set
# to your deployed frontend origin(s), e.g. https://app.example.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Explicit Fernet key for document encryption at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key is derived from JWT_SECRET (rotating JWT_SECRET then breaks files).
DOC_ENCRYPTION_KEY=
# false in production (default). Set true only for local debugging.
DEBUG=false
# true = process the pipeline via the async worker (run: python -m app.worker).
ASYNC_INGEST=false
